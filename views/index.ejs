<%- include("header.ejs")%>
    <form action="/generate" method="post">
        <label for="selectX" name="label-selectX">Choose a width</label>
        <select name="selectX" id="selectX">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
        </select>

        <label for="selectY" name="label-selectY">Choose a height</label>
        <select name="selectY" id="selectY">
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="20">20</option>
        </select>
        <button type="submit">Generate nonogram</button>
    </form>

    <%if(locals.lengthX && locals.lengthY && locals.coordinates &&locals.cluesX && locals.cluesY){%>
        <div>
            <%var isFirstX = true%> 
            <span class="clue-outer" id="filler-clue"></span>
            <%for(j = 0; j < lengthX; j++){%>
                <span class="clue-outer clue-y" id="<%='clue '+j%>"><% cluesX.forEach(clue =>{%>
                    <%if(clue[0]==j){%>
                        <%isFirstX = true;%>
                        <span class="clue-inner"><%=clue[1]%></span>
                    <%}else if (cluesX.find(clueX => clueX[0]==j)===undefined && isFirstX){%>
                        <span class="clue-inner">0</span>  
                    <%isFirstX = false;}%>
                <%}) %></span>
            <%}%>
        </div>
        <%var isFirstY = true;%> 
        <%for(i = 0; i < lengthY; i++){%>
            <div>
                <span class="clue-outer" id="<%='clue '+ i%>"><% cluesY.forEach(clue =>{%>
                    <%if(clue[0]==i){%>
                        <%
                            isFirstY = true;
                        %>
                        <span class="clue-inner"><%=clue[1]%></span>
                    <%}else if (cluesY.find(clueY => clueY[0]==i)===undefined && isFirstY){%>
                        <span class="clue-inner">0</span>  
                    <%
                        isFirstY = false;
                    }
                    %>
             <%}) %></span>
            <%for(j = 0; j < lengthX; j++){%>
                <%var currentId=i+','+j%>
                <span id="<%=i+','+j%>" class="grid-span" onclick="this.style='background-color:black;';"></span>
            <%}%>
            </div>
        <%}%>
    <%}%>
<%- include("footer.ejs")%>